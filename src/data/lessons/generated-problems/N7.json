  {"schemaVersion":"1.0.0","lessonId":"N7","purpose":"practice","transferLevel":"near","targetConcepts":["N7"],"inspirationProblemIds":[],"problem":{"id":"original-n7-value-eight","title":"The Value of One Digit","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Place value","difficulty":1,"statement":"What value does the digit 8 contribute to the numeral 5082?","choices":[{"label":"A","text":"8"},{"label":"B","text":"80"},{"label":"C","text":"800"},{"label":"D","text":"8000"}],"answer":"B","shortAnswer":"80","hints":["Locate the tens place.","Multiply 8 by its place weight."],"solutionSteps":[{"title":"Use the place weight","body":"The digit 8 is in the tens place, so it contributes 8×10=80."}],"tags":["digit value","decimal place value"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["weighted expansion of 5082","independent comparison 5082 minus 5002 equals 80","answer-choice audit"],"notes":["The digit symbol and contribution are correctly distinguished."]}},
  {"schemaVersion":"1.0.0","lessonId":"N7","purpose":"practice","transferLevel":"near","targetConcepts":["N7"],"inspirationProblemIds":[],"problem":{"id":"original-n7-leading-zero","title":"Leading Zero Padding","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Place value","difficulty":1,"statement":"Which statement about 0074 is correct?","choices":[{"label":"A","text":"It is a four-digit number with value 74."},{"label":"B","text":"It has value 74 and its standard numeral is two-digit."},{"label":"C","text":"It has value 7400."},{"label":"D","text":"It has value 0."}],"answer":"B","shortAnswer":"value 74, standard length two","hints":["Expand every written place.","Find the first nonzero digit."],"solutionSteps":[{"title":"Remove zero contributions","body":"0×1000+0×100+7×10+4=74, whose standard numeral has two digits."}],"tags":["leading zero","place value"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["weighted expansion including zero columns","independent deletion of left padding before reading 74","answer-choice audit"],"notes":["Choice B uniquely states both value and standard length."]}},
