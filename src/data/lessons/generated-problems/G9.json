[
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"teaching","transferLevel":"discovery","targetConcepts":["G9","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g9-rigid-copy","title":"What Survives the Move?","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Rigid transformations","difficulty":1,"statement":"A scalene triangle with side lengths 3, 4, and 5 is translated, rotated, or reflected. Which properties must be unchanged in every image?","choices":[{"label":"A","text":"Position and direction faced"},{"label":"B","text":"Side lengths and angle measures"},{"label":"C","text":"Clockwise vertex order"},{"label":"D","text":"Coordinates of every vertex"}],"answer":"B","shortAnswer":"Side lengths and angle measures","hints":["Rigid motions do not stretch.","Reflection may reverse orientation."],"solutionSteps":[{"title":"Track invariants","body":"Translation, rotation, and reflection preserve all distances and angle measures."}],"tags":["transformations","rigid motion","invariants"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["rigid-motion definition audit","independent counterexample audit: position, facing, coordinates, and orientation can change, leaving only B universal"]}},
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"practice","transferLevel":"near","targetConcepts":["G9"],"inspirationProblemIds":[],"problem":{"id":"original-g9-translation","title":"Translate a Point","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Coordinate transformations","difficulty":1,"statement":"Point (−2,5) is translated 4 units right and 3 units down. What is its image?","choices":[{"label":"A","text":"(2,2)"},{"label":"B","text":"(2,8)"},{"label":"C","text":"(−6,2)"},{"label":"D","text":"(−6,8)"}],"answer":"A","shortAnswer":"(2,2)","hints":["Add 4 to x.","Subtract 3 from y."],"solutionSteps":[{"title":"Apply the vector","body":"(−2+4,5−3)=(2,2)."}],"tags":["translation","coordinates"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["coordinate vector addition","independent inverse translation (2,2)+(−4,3)=(−2,5); option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"practice","transferLevel":"near","targetConcepts":["G9","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g9-rotation","title":"Quarter-Turn Image","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Rotation","difficulty":2,"statement":"Point (3,1) is rotated 90° counterclockwise about the origin. What is its image?","choices":[{"label":"A","text":"(1,−3)"},{"label":"B","text":"(−1,3)"},{"label":"C","text":"(−3,−1)"},{"label":"D","text":"(3,−1)"}],"answer":"B","shortAnswer":"(−1,3)","hints":["Use (x,y)→(−y,x).","Check that distance from the origin is preserved."],"solutionSteps":[{"title":"Turn the coordinate vector","body":"(3,1)→(−1,3)."}],"tags":["rotation","coordinates","quarter turn"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["90-degree counterclockwise coordinate rule","independent polar/distance check: vector moves from quadrant I to II and both squared distances equal 10; choices audited"]}},
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"practice","transferLevel":"mixed","targetConcepts":["G9"],"inspirationProblemIds":[],"problem":{"id":"original-g9-reflection","title":"Mirror Across the y-Axis","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Reflection","difficulty":1,"statement":"What is the reflection of point (−4,2) across the y-axis?","choices":[{"label":"A","text":"(4,2)"},{"label":"B","text":"(−4,−2)"},{"label":"C","text":"(4,−2)"},{"label":"D","text":"(−2,4)"}],"answer":"A","shortAnswer":"(4,2)","hints":["Keep the same height.","Reverse horizontal signed distance."],"solutionSteps":[{"title":"Reflect","body":"(x,y)→(−x,y), so (−4,2)→(4,2)."}],"tags":["reflection","coordinates"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["y-axis reflection rule","independent midpoint check: endpoints have midpoint (0,2) on the y-axis and equal perpendicular distance 4; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"practice","transferLevel":"mixed","targetConcepts":["G9","G6"],"inspirationProblemIds":[],"problem":{"id":"original-g9-dilation","title":"Scale from a Center","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Dilation","difficulty":2,"statement":"A figure has perimeter 12 and area 10. After a dilation of scale factor 3, what are its perimeter and area?","choices":[{"label":"A","text":"36 and 30"},{"label":"B","text":"36 and 90"},{"label":"C","text":"108 and 90"},{"label":"D","text":"108 and 270"}],"answer":"B","shortAnswer":"36 and 90","hints":["Perimeter scales linearly.","Area scales by the square."],"solutionSteps":[{"title":"Apply dimension factors","body":"Perimeter=12×3=36; area=10×3²=90."}],"tags":["dilation","perimeter","area"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["dimension-based scaling","independent ratio audit 36/12=3 and 90/10=9; options checked"]}},
  {"schemaVersion":"1.0.0","lessonId":"G9","purpose":"practice","transferLevel":"challenge","targetConcepts":["G9"],"inspirationProblemIds":[],"problem":{"id":"original-g9-composition","title":"Translate, Then Reflect","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Transformation composition","difficulty":2,"statement":"Point (1,2) is translated by vector (2,2), then reflected across the y-axis. What is the final image?","choices":[{"label":"A","text":"(−3,4)"},{"label":"B","text":"(3,−4)"},{"label":"C","text":"(−1,4)"},{"label":"D","text":"(1,−4)"}],"answer":"A","shortAnswer":"(−3,4)","hints":["Apply the operations in order.","Write the intermediate point."],"solutionSteps":[{"title":"Translate","body":"(1,2)+(2,2)=(3,4)."},{"title":"Reflect","body":"(3,4)→(−3,4)."}],"tags":["composition","translation","reflection"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["sequential coordinate rules","independent inverse audit: reflect (−3,4) to (3,4), then subtract vector (2,2) to recover (1,2); option audit"]}}
