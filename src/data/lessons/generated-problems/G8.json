[
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"teaching","transferLevel":"discovery","targetConcepts":["G8","G3"],"inspirationProblemIds":[],"problem":{"id":"original-g8-rim-disc","title":"Rim and Disc","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Circle measurements","difficulty":1,"statement":"A circular sign has radius 3 units. What are its circumference and area, respectively?","choices":[{"label":"A","text":"3π units and 6π square units"},{"label":"B","text":"6π units and 9π square units"},{"label":"C","text":"9π units and 6π square units"},{"label":"D","text":"9π units and 18π square units"}],"answer":"B","shortAnswer":"6π units and 9π square units","hints":["Circumference traces the rim.","Area covers the disc."],"solutionSteps":[{"title":"Measure separately","body":"C=2π(3)=6π units; A=π(3²)=9π square units."}],"tags":["circle","circumference","area","units"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["direct circle formula evaluation","independent dimensional and diameter audit: d=6 gives C=πd=6π while unit-square coverage is 9π; options checked"]}},
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"practice","transferLevel":"near","targetConcepts":["G8"],"inspirationProblemIds":[],"problem":{"id":"original-g8-radius","title":"Diameter to Circumference","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Circle circumference","difficulty":1,"statement":"A circle has diameter 18 units. What is its circumference?","choices":[{"label":"A","text":"9π"},{"label":"B","text":"18π"},{"label":"C","text":"36π"},{"label":"D","text":"81π"}],"answer":"B","shortAnswer":"18π units","hints":["Use C=πd.","Or halve diameter, then use 2πr."],"solutionSteps":[{"title":"Use the diameter","body":"C=π(18)=18π units."}],"tags":["diameter","circumference"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["diameter formula C=πd=18π","independent radius method r=9 gives 2πr=18π; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"practice","transferLevel":"near","targetConcepts":["G8","G3"],"inspirationProblemIds":[],"problem":{"id":"original-g8-two-measures","title":"One Radius, Two Measures","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Circle area and circumference","difficulty":1,"statement":"A circle has radius 5 cm. What are its circumference and area?","choices":[{"label":"A","text":"10π cm and 25π cm²"},{"label":"B","text":"25π cm and 10π cm²"},{"label":"C","text":"10π cm and 10π cm²"},{"label":"D","text":"25π cm and 25π cm²"}],"answer":"A","shortAnswer":"10π cm and 25π cm²","hints":["Use one radius factor for circumference.","Use radius squared for area."],"solutionSteps":[{"title":"Compute and label","body":"C=2π(5)=10π cm and A=π(5²)=25π cm²."}],"tags":["circle","circumference","area"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["separate formula evaluation","independent dimension/unit audit makes only A consistent"]}},
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"practice","transferLevel":"mixed","targetConcepts":["G8","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g8-sector","title":"Seventy-Two-Degree Sector","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Sector area","difficulty":2,"statement":"A circle has radius 10. What is the area of a 72° sector?","choices":[{"label":"A","text":"10π"},{"label":"B","text":"20π"},{"label":"C","text":"36π"},{"label":"D","text":"72π"}],"answer":"B","shortAnswer":"20π square units","hints":["72/360=1/5.","Find one fifth of the full circle area."],"solutionSteps":[{"title":"Find whole and share","body":"A=100π and sector=(1/5)(100π)=20π."}],"tags":["sector","central angle","area"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["central-angle fraction (72/360)π10²=20π","independent five-equal-sector check: 5·20π=100π; options audited"]}},
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"practice","transferLevel":"mixed","targetConcepts":["G8"],"inspirationProblemIds":[],"problem":{"id":"original-g8-scale","title":"Triple the Radius","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Circle scaling","difficulty":2,"statement":"A circle's radius is tripled. By what factor does its area change?","choices":[{"label":"A","text":"3"},{"label":"B","text":"6"},{"label":"C","text":"9"},{"label":"D","text":"27"}],"answer":"C","shortAnswer":"9","hints":["Area uses r².","Compare π(3r)² with πr²."],"solutionSteps":[{"title":"Square the length factor","body":"π(3r)²=9πr², so area is multiplied by 9."}],"tags":["circle area","scale factor"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["symbolic scale comparison","independent numerical check r=1 gives areas π and 9π; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G8","purpose":"practice","transferLevel":"challenge","targetConcepts":["G8","G4"],"inspirationProblemIds":[],"problem":{"id":"original-g8-annulus-sector","title":"Quarter of a Ring","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Annular sector","difficulty":3,"statement":"Two concentric circles have radii 8 and 4. What is the area of a 90° sector of the region between them?","choices":[{"label":"A","text":"8π"},{"label":"B","text":"12π"},{"label":"C","text":"16π"},{"label":"D","text":"48π"}],"answer":"B","shortAnswer":"12π square units","hints":["Subtract the full circle areas first.","Then take one quarter."],"solutionSteps":[{"title":"Find the annulus","body":"π(8²−4²)=π(64−16)=48π."},{"title":"Take the sector","body":"90/360=1/4, so area=(1/4)(48π)=12π."}],"tags":["annulus","sector","area decomposition"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["annulus difference then quarter-sector calculation","independent sector difference: quarter of 64π minus quarter of 16π equals 16π−4π=12π; choices audited"]}}
]
