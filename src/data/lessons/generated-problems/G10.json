  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"teaching","transferLevel":"discovery","targetConcepts":["G10","G3"],"inspirationProblemIds":[],"problem":{"id":"original-g10-layers-skin","title":"Fill or Cover the Prism","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Volume and surface area","difficulty":1,"statement":"A rectangular prism measures 3 by 2 by 4 units. What are its volume and surface area?","choices":[{"label":"A","text":"24 cubic units and 26 square units"},{"label":"B","text":"24 cubic units and 52 square units"},{"label":"C","text":"52 cubic units and 24 square units"},{"label":"D","text":"48 cubic units and 52 square units"}],"answer":"B","shortAnswer":"24 cubic units and 52 square units","hints":["Count cubes as base layers.","Count three pairs of exposed face rectangles."],"solutionSteps":[{"title":"Fill","body":"V=3×2×4=24 cubic units."},{"title":"Cover","body":"SA=2(3×2+3×4+2×4)=2(6+12+8)=52 square units."}],"tags":["prism","volume","surface area"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["layer count and paired-face formula","independent face inventory 6+6+12+12+8+8=52 and cube count 24; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"practice","transferLevel":"near","targetConcepts":["G10"],"inspirationProblemIds":[],"problem":{"id":"original-g10-prism-both","title":"Two Measures of a Prism","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Prism measurements","difficulty":1,"statement":"A rectangular prism measures 5 by 3 by 2. What are its volume and surface area?","choices":[{"label":"A","text":"30 and 31"},{"label":"B","text":"30 and 62"},{"label":"C","text":"60 and 31"},{"label":"D","text":"60 and 62"}],"answer":"B","shortAnswer":"30 cubic units and 62 square units","hints":["Multiply all dimensions for volume.","Double the sum of the three distinct face areas."],"solutionSteps":[{"title":"Compute separately","body":"V=30 and SA=2(15+10+6)=62."}],"tags":["rectangular prism","volume","surface area"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["standard prism formulas","independent unit-cube layers and six-face sum; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"practice","transferLevel":"near","targetConcepts":["G10"],"inspirationProblemIds":[],"problem":{"id":"original-g10-units","title":"Capacity Units","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Dimensional units","difficulty":1,"statement":"A box measures 4 cm by 3 cm by 2 cm. Which measurement correctly gives its volume?","choices":[{"label":"A","text":"9 cm"},{"label":"B","text":"18 cm²"},{"label":"C","text":"24 cm²"},{"label":"D","text":"24 cm³"}],"answer":"D","shortAnswer":"24 cm³","hints":["Volume fills three dimensions.","Multiply the three side lengths."],"solutionSteps":[{"title":"Count unit cubes","body":"4×3×2=24 one-centimeter cubes, so volume is 24 cm³."}],"tags":["volume","cubic units"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["direct product 4·3·2=24","independent dimensional unit audit selects cubic centimeters and rejects equal-number square-unit distractor"]}},
  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"practice","transferLevel":"mixed","targetConcepts":["G10"],"inspirationProblemIds":[],"problem":{"id":"original-g10-cube-chain","title":"Four Cubes in a Row","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Exposed faces","difficulty":2,"statement":"Four unit cubes are glued in a straight face-to-face chain. How many unit-square faces are exposed?","choices":[{"label":"A","text":"16"},{"label":"B","text":"18"},{"label":"C","text":"20"},{"label":"D","text":"24"}],"answer":"B","shortAnswer":"18","hints":["Begin with 4×6 face descriptions.","Each of the three contacts hides two."],"solutionSteps":[{"title":"Correct for contacts","body":"24−2(3)=18 exposed faces."}],"tags":["cubes","surface area","contacts"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["all-faces-minus-contacts calculation","independent 1×1×4 prism formula 2(1+4+4)=18; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"practice","transferLevel":"mixed","targetConcepts":["G10","G6"],"inspirationProblemIds":[],"problem":{"id":"original-g10-scale","title":"Scale a Solid","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"3D scale factors","difficulty":2,"statement":"A solid is dilated by linear scale factor 3. By what factors do its surface area and volume change?","choices":[{"label":"A","text":"3 and 3"},{"label":"B","text":"3 and 9"},{"label":"C","text":"9 and 27"},{"label":"D","text":"27 and 81"}],"answer":"C","shortAnswer":"9 and 27","hints":["Area is two-dimensional.","Volume is three-dimensional."],"solutionSteps":[{"title":"Use dimensional powers","body":"Surface area factor=3²=9; volume factor=3³=27."}],"tags":["dilation","surface area","volume"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["dimension-power rule","independent unit-cube check: 1-cube becomes 3×3×3 with 27 cubes while each face becomes 3×3; options audited"]}},
  {"schemaVersion":"1.0.0","lessonId":"G10","purpose":"practice","transferLevel":"challenge","targetConcepts":["G10","G3"],"inspirationProblemIds":[],"problem":{"id":"original-g10-open-box","title":"Open-Top Box Material","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Surface area","difficulty":2,"statement":"An open-top rectangular box is 6 units long, 4 units wide, and 2 units high. What is the area of material in its base and four sides?","choices":[{"label":"A","text":"40"},{"label":"B","text":"56"},{"label":"C","text":"64"},{"label":"D","text":"88"}],"answer":"C","shortAnswer":"64 square units","hints":["There is one base and no top.","Count two long sides and two short sides."],"solutionSteps":[{"title":"List exposed material faces","body":"Base=24, long sides=2(6×2)=24, short sides=2(4×2)=16."},{"title":"Total","body":"24+24+16=64 square units."}],"tags":["open box","surface area","face inventory"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["explicit five-face inventory 24+24+16=64","independent closed-prism check 2(24+12+8)=88 minus missing top 24 equals 64; option audit"]}}
