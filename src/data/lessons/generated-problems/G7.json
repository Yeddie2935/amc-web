  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"teaching","transferLevel":"discovery","targetConcepts":["G7","G2"],"inspirationProblemIds":[],"problem":{"id":"original-g7-square-family","title":"How Many Families?","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Quadrilateral classification","difficulty":1,"statement":"Which list contains only categories to which every square belongs?","choices":[{"label":"A","text":"rectangle, rhombus, parallelogram, quadrilateral"},{"label":"B","text":"rectangle, trapezoid only, triangle"},{"label":"C","text":"rhombus, pentagon, quadrilateral"},{"label":"D","text":"square only"}],"answer":"A","shortAnswer":"rectangle, rhombus, parallelogram, quadrilateral","hints":["Test each definition against four equal sides and four right angles.","Categories may be nested."],"solutionSteps":[{"title":"Check properties","body":"A square has four right angles, four equal sides, and both opposite pairs parallel."},{"title":"Apply definitions","body":"Those properties satisfy rectangle, rhombus, parallelogram, and quadrilateral definitions."}],"tags":["quadrilaterals","classification","nested families"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["definition-by-definition property audit","independent option audit rejects lists containing non-four-sided or exclusive claims"]}},
  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"practice","transferLevel":"near","targetConcepts":["G7"],"inspirationProblemIds":[],"problem":{"id":"original-g7-family","title":"Rhombus Membership","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Quadrilateral hierarchy","difficulty":1,"statement":"Which statement is always true?","choices":[{"label":"A","text":"Every rhombus is a square."},{"label":"B","text":"Every rhombus is a rectangle."},{"label":"C","text":"Every rhombus is a parallelogram."},{"label":"D","text":"No rhombus is a quadrilateral."}],"answer":"C","shortAnswer":"Every rhombus is a parallelogram","hints":["A rhombus has both pairs of opposite sides parallel.","Right angles are not required."],"solutionSteps":[{"title":"Use the defining relationships","body":"A rhombus has four equal sides and both opposite pairs parallel, so it satisfies the parallelogram definition."}],"tags":["rhombus","parallelogram","classification"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["quadrilateral definition audit","counterexample audit: a non-square slanted rhombus rejects A and B; D contradicts four-sided definition"]}},
  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"practice","transferLevel":"near","targetConcepts":["G7"],"inspirationProblemIds":[],"problem":{"id":"original-g7-insufficient","title":"Four Sides, What Else?","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Polygon properties","difficulty":1,"statement":"A figure is known only to be a quadrilateral. How many pairs of parallel sides must it have?","choices":[{"label":"A","text":"0"},{"label":"B","text":"1"},{"label":"C","text":"2"},{"label":"D","text":"It cannot be determined."}],"answer":"D","shortAnswer":"Cannot be determined","hints":["Quadrilateral guarantees four sides.","Compare trapezoids, parallelograms, and irregular quadrilaterals."],"solutionSteps":[{"title":"Test examples","body":"Quadrilaterals can have zero, one, or two parallel pairs, so the count is not determined."}],"tags":["quadrilateral","parallel sides","insufficient information"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["definition audit: four sides imposes no parallel condition","explicit counterexamples with 0, 1, and 2 parallel pairs make only D universally correct"]}},
  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"practice","transferLevel":"mixed","targetConcepts":["G7","G2"],"inspirationProblemIds":[],"problem":{"id":"original-g7-angle-sum","title":"Nonagon Angle Sum","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Polygon angle sums","difficulty":2,"statement":"What is the sum of the interior angles of a nonagon?","choices":[{"label":"A","text":"1080°"},{"label":"B","text":"1260°"},{"label":"C","text":"1440°"},{"label":"D","text":"1620°"}],"answer":"B","shortAnswer":"1260°","hints":["A nonagon has 9 sides.","Fan it into 9−2 triangles."],"solutionSteps":[{"title":"Count triangles","body":"A nonagon fans into 7 triangles."},{"title":"Total their angles","body":"7×180°=1260°."}],"tags":["nonagon","interior angles","triangulation"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["n−2 triangulation: 7·180=1260","independent exterior-supplement check 9·180−360=1260; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"practice","transferLevel":"mixed","targetConcepts":["G7"],"inspirationProblemIds":[],"problem":{"id":"original-g7-regular","title":"Regular Octagon Angle","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Regular polygons","difficulty":2,"statement":"What is each interior angle of a regular octagon?","choices":[{"label":"A","text":"45°"},{"label":"B","text":"90°"},{"label":"C","text":"135°"},{"label":"D","text":"180°"}],"answer":"C","shortAnswer":"135°","hints":["Find the total interior angle sum.","Regularity makes all eight angles equal."],"solutionSteps":[{"title":"Find and share the total","body":"(8−2)180°=1080°, and 1080°/8=135°."}],"tags":["regular octagon","interior angle"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["interior-sum division 1080/8=135","independent exterior angle 360/8=45 and supplement 180−45=135; choices audited"]}},
  {"schemaVersion":"1.0.0","lessonId":"G7","purpose":"practice","transferLevel":"challenge","targetConcepts":["G7","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g7-exterior","title":"Regular Fifteen-Gon Turn","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Exterior angles","difficulty":2,"statement":"What is each exterior turning angle of a regular 15-gon?","choices":[{"label":"A","text":"12°"},{"label":"B","text":"24°"},{"label":"C","text":"156°"},{"label":"D","text":"168°"}],"answer":"B","shortAnswer":"24°","hints":["One circuit turns 360°.","Regularity shares that turn equally."],"solutionSteps":[{"title":"Share the full turn","body":"360°/15=24° per exterior turn."}],"tags":["regular polygon","exterior angle","turn"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["full-turn division 360/15=24","independent interior calculation ((15−2)180)/15=156 and supplement 180−156=24; option audit"]}}
