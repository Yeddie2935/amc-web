  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"teaching","transferLevel":"discovery","targetConcepts":["G2","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g2-moving-vertex","title":"What Survives the Move?","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Triangle angle sum","difficulty":1,"statement":"Triangle A has angles 52°, 63°, and 65°. One vertex is moved to make Triangle B, whose two measured angles are 35° and 74°. What is Triangle B's third angle?","choices":[{"label":"A","text":"61°"},{"label":"B","text":"65°"},{"label":"C","text":"71°"},{"label":"D","text":"109°"}],"answer":"C","shortAnswer":"71°","hints":["Moving a vertex changes individual angles, not their required total.","Subtract both known angles from 180°."],"solutionSteps":[{"title":"Use the invariant","body":"Triangle B's angles still sum to 180°."},{"title":"Find the remainder","body":"180° − 35° − 74° = 71°."}],"tags":["triangles","angle sum","invariant"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["triangle sum subtraction: 180-35-74=71","independent total check: 35+74+71=180; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"practice","transferLevel":"near","targetConcepts":["G2"],"inspirationProblemIds":[],"problem":{"id":"original-g2-missing-angle","title":"Complete the Triangle","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Triangle angle sum","difficulty":1,"statement":"A triangle has angles 42°, 65°, and x°. What is x?","choices":[{"label":"A","text":"63°"},{"label":"B","text":"73°"},{"label":"C","text":"83°"},{"label":"D","text":"107°"}],"answer":"B","shortAnswer":"73°","hints":["The three interior angles total 180°.","Subtract 42° and 65°."],"solutionSteps":[{"title":"Find the missing share","body":"x = 180° − 42° − 65° = 73°."}],"tags":["triangles","angle sum"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["direct subtraction 180-42-65=73","independent addition 42+65+73=180; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"practice","transferLevel":"near","targetConcepts":["G2"],"inspirationProblemIds":[],"problem":{"id":"original-g2-rotated","title":"Turned but Unchanged","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Triangle classification","difficulty":1,"statement":"A triangle points sideways in a diagram, and all three sides carry the same length mark. Which classification is guaranteed?","choices":[{"label":"A","text":"Scalene"},{"label":"B","text":"Isosceles but not equilateral"},{"label":"C","text":"Equilateral"},{"label":"D","text":"Right"}],"answer":"C","shortAnswer":"Equilateral","hints":["Use the side marks rather than orientation.","Equilateral describes three equal sides."],"solutionSteps":[{"title":"Read the defining property","body":"All three side lengths are equal, so the triangle is equilateral regardless of its rotation."}],"tags":["triangles","classification","rotation"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["definition audit: three equal sides is exactly equilateral","rigid-rotation invariant: rotation preserves all lengths; choice audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"practice","transferLevel":"mixed","targetConcepts":["G2"],"inspirationProblemIds":[],"problem":{"id":"original-g2-isosceles-angle","title":"Share the Remainder","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Isosceles triangles","difficulty":2,"statement":"An isosceles triangle has a vertex angle of 46°. What is the measure of each base angle?","choices":[{"label":"A","text":"46°"},{"label":"B","text":"64°"},{"label":"C","text":"67°"},{"label":"D","text":"134°"}],"answer":"C","shortAnswer":"67°","hints":["The base angles are equal.","Share the amount left after 46° equally."],"solutionSteps":[{"title":"Find the remainder","body":"180° − 46° = 134°."},{"title":"Split equally","body":"134° ÷ 2 = 67° for each base angle."}],"tags":["isosceles triangle","base angles","angle sum"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["equal split: (180-46)/2=67","independent total check: 46+67+67=180; option audit"]}},
  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"practice","transferLevel":"mixed","targetConcepts":["G2","G1"],"inspirationProblemIds":[],"problem":{"id":"original-g2-exterior","title":"Collect the Far Angles","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Exterior angles","difficulty":2,"statement":"Two interior angles of a triangle measure 38° and 79°. What is the exterior angle at the third vertex?","choices":[{"label":"A","text":"63°"},{"label":"B","text":"101°"},{"label":"C","text":"117°"},{"label":"D","text":"142°"}],"answer":"C","shortAnswer":"117°","hints":["The exterior angle equals the sum of the remote interior angles.","Or find the third interior angle and take its supplement."],"solutionSteps":[{"title":"Add the remote angles","body":"38° + 79° = 117°."},{"title":"Check by supplementation","body":"The third interior angle is 63°, and 63° + 117° = 180°."}],"tags":["triangle","exterior angle","supplementary"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["exterior-angle sum: 38+79=117","independent triangle and linear-pair check: third interior 63 and 180-63=117; choices audited"]}},
  {"schemaVersion":"1.0.0","lessonId":"G2","purpose":"practice","transferLevel":"challenge","targetConcepts":["G2"],"inspirationProblemIds":[],"problem":{"id":"original-g2-nested","title":"Name the Active Triangle","sourceType":"Original","contest":"Original","category":"Geometry","subcategory":"Nested triangles","difficulty":2,"statement":"In a diagram containing several segments, triangle QRS has angle RQS = 41° and angle QSR = 56°. What is angle QRS?","choices":[{"label":"A","text":"83°"},{"label":"B","text":"97°"},{"label":"C","text":"124°"},{"label":"D","text":"139°"}],"answer":"A","shortAnswer":"83°","hints":["Use only angles belonging to triangle QRS.","Subtract its two known angles from 180°."],"solutionSteps":[{"title":"Restrict the sum","body":"Within triangle QRS, angle QRS = 180° − 41° − 56° = 83°."}],"tags":["triangles","angle sum","diagram reading"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["named-triangle subtraction 180-41-56=83","independent total check 41+56+83=180; extraneous-segment irrelevance and option audit"]}}
