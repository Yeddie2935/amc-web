[
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"teaching","transferLevel":"discovery","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-split-sixty","title":"Two Ways to Split Sixty","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime factorization","difficulty":1,"statement":"One student starts 60 = 6 × 10. Another starts 60 = 12 × 5. If both keep splitting composite factors, which sorted list of terminal factors will both obtain?","choices":[{"label":"A","text":"2, 2, 3, 5"},{"label":"B","text":"2, 3, 10"},{"label":"C","text":"3, 4, 5"},{"label":"D","text":"1, 2, 2, 3, 5"}],"answer":"A","shortAnswer":"2, 2, 3, 5","hints":["Split 6, 10, 12, and 4.","Stop only when every factor is prime."],"solutionSteps":[{"title":"Complete the first path","body":"6 × 10 = (2 × 3)(2 × 5), giving 2, 2, 3, 5."},{"title":"Complete the second path","body":"12 × 5 = (3 × 4) × 5 = 3 × 2 × 2 × 5, which sorts to the same list."}],"tags":["prime factorization","factor tree","uniqueness"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["independent completion of both factor trees","direct product check 2 times 2 times 3 times 5 equals 60","answer-choice audit"],"notes":["Both paths have the same terminal prime multiset."]}},
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"practice","transferLevel":"near","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-factor-eightyfour","title":"Factor Eighty-Four","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime factorization","difficulty":1,"statement":"What is the prime factorization of 84?","choices":[{"label":"A","text":"2 × 42"},{"label":"B","text":"2² × 3 × 7"},{"label":"C","text":"2 × 3² × 7"},{"label":"D","text":"4 × 3 × 7"}],"answer":"B","shortAnswer":"2² × 3 × 7","hints":["Divide by 2 while the quotient is even.","Factor 21 completely."],"solutionSteps":[{"title":"Split to primes","body":"84 = 2 × 42 = 2 × 2 × 21 = 2² × 3 × 7."}],"tags":["prime factorization","exponents"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["repeated division by primes","independent product check 4 times 3 times 7 equals 84","answer-choice audit"],"notes":["Choice B is the only complete prime-only product."]}},
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"practice","transferLevel":"near","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-classify","title":"Prime, Composite, or Neither","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime classification","difficulty":2,"statement":"Which classification is correct?","choices":[{"label":"A","text":"1 prime; 29 prime; 39 composite"},{"label":"B","text":"1 neither; 29 prime; 39 composite"},{"label":"C","text":"1 neither; 29 composite; 39 prime"},{"label":"D","text":"1 composite; 29 prime; 39 prime"}],"answer":"B","shortAnswer":"1 neither; 29 prime; 39 composite","hints":["Count the divisors of 1.","For 29, test primes no larger than its square root.","Use the digit sum of 39."],"solutionSteps":[{"title":"Classify each number","body":"One has one positive divisor. No prime at most √29 divides 29. The digit sum of 39 is 12, so 39 = 3 × 13."}],"tags":["prime","composite","divisors"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["exact divisor-count definition for 1","trial division of 29 by 2, 3, and 5","independent factor identity 39 equals 3 times 13","answer-choice audit"],"notes":["Choice B uniquely classifies all three numbers."]}},
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"practice","transferLevel":"mixed","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-path-ninety","title":"Two Trees for Ninety","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime factorization","difficulty":2,"statement":"One factor tree for 90 begins 9 × 10, and another begins 15 × 6. Which statement is true after both trees are completed?","choices":[{"label":"A","text":"The first gives 2 × 3² × 5 and the second gives 2 × 3 × 5."},{"label":"B","text":"Both give 2 × 3² × 5."},{"label":"C","text":"Both give 3² × 10."},{"label":"D","text":"Different starting pairs cannot represent the same number."}],"answer":"B","shortAnswer":"Both give 2 × 3² × 5","hints":["Split each member of both starting pairs.","Sort the terminal leaves."],"solutionSteps":[{"title":"Complete both paths","body":"9 × 10 = (3 × 3)(2 × 5), while 15 × 6 = (3 × 5)(2 × 3). Each yields 2 × 3² × 5."}],"tags":["factor tree","unique factorization","multiplicity"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["completion of factor path 9 times 10","independent completion of factor path 15 times 6","direct reconstruction 2 times 9 times 5 equals 90","answer-choice audit"],"notes":["Both complete paths have identical prime multiplicities."]}},
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"practice","transferLevel":"mixed","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-exponent-rebuild","title":"Rebuild an Exponent Inventory","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime exponents","difficulty":2,"statement":"Which number has prime factorization 2³ × 5²?","choices":[{"label":"A","text":"50"},{"label":"B","text":"100"},{"label":"C","text":"200"},{"label":"D","text":"400"}],"answer":"C","shortAnswer":"200","hints":["Evaluate each prime power.","Multiply 8 by 25."],"solutionSteps":[{"title":"Expand and multiply","body":"2³ × 5² = 8 × 25 = 200."}],"tags":["prime exponents","reconstruction"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["direct prime-power evaluation 8 times 25","independent expansion 2 times 2 times 2 times 5 times 5","answer-choice audit"],"notes":["The specified inventory reconstructs 200 uniquely."]}},
  {"schemaVersion":"1.0.0","lessonId":"N2","purpose":"practice","transferLevel":"challenge","targetConcepts":["N2"],"inspirationProblemIds":[],"problem":{"id":"original-n2-square-multiplier","title":"Complete a Square","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Prime exponents","difficulty":3,"statement":"What is the least positive integer m for which 540m is a perfect square?","choices":[{"label":"A","text":"3"},{"label":"B","text":"5"},{"label":"C","text":"15"},{"label":"D","text":"30"},{"label":"E","text":"45"}],"answer":"C","shortAnswer":"15","hints":["Factor 540 as 2² × 3³ × 5.","A square has even prime exponents."],"solutionSteps":[{"title":"Find the exponent gaps","body":"In 2² × 3³ × 5¹, the exponents of 3 and 5 are odd. Multiply by one more 3 and one more 5, so m = 15."},{"title":"Verify and prove minimality","body":"540 × 15 = 2² × 3⁴ × 5² = 8100 = 90². Both added primes are necessary to repair the two odd exponents."}],"tags":["perfect square","prime exponents","least multiplier"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["prime-exponent parity completion","independent numerical square check 540 times 15 equals 8100 equals 90 squared","answer-choice divisibility audit"],"notes":["Fifteen is necessary and sufficient."]}}
]
