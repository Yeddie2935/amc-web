[
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"teaching","transferLevel":"discovery","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-five-position-walk","title":"Return to the Same Position","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Remainders","difficulty":1,"statement":"Which set of numbers all leaves remainder 3 when divided by 5?","choices":[{"label":"A","text":"3, 8, 13"},{"label":"B","text":"3, 7, 11"},{"label":"C","text":"5, 10, 15"},{"label":"D","text":"4, 9, 13"}],"answer":"A","shortAnswer":"3, 8, 13","hints":["Remove complete groups of five.","Numbers in one remainder class differ by multiples of five."],"solutionSteps":[{"title":"Write division forms","body":"3=5×0+3, 8=5×1+3, and 13=5×2+3."}],"tags":["remainders","repeating positions","modulo 5"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["direct division of every listed number by 5","independent difference check that 8−3 and 13−8 equal 5","answer-choice audit"],"notes":["Only choice A shares remainder three throughout."]}},
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"practice","transferLevel":"near","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-remainder-137","title":"Remainder of 137","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Remainders","difficulty":1,"statement":"What is the remainder when 137 is divided by 6?","choices":[{"label":"A","text":"1"},{"label":"B","text":"3"},{"label":"C","text":"5"},{"label":"D","text":"6"}],"answer":"C","shortAnswer":"5","hints":["Find the greatest multiple of 6 below 137.","Check that the leftover is less than 6."],"solutionSteps":[{"title":"Subtract a complete multiple","body":"6×22=132, so 137=6×22+5."}],"tags":["remainder","division algorithm"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["quotient-remainder equation 137 equals 6 times 22 plus 5","independent modular reduction 137−120−12 equals 5","answer-choice audit"],"notes":["Five is the unique standard remainder."]}},
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"practice","transferLevel":"near","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-valid-remainder","title":"An Impossible Remainder","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Remainders","difficulty":1,"statement":"Which number cannot be the remainder after division by 7?","choices":[{"label":"A","text":"0"},{"label":"B","text":"3"},{"label":"C","text":"6"},{"label":"D","text":"7"}],"answer":"D","shortAnswer":"7","hints":["A remainder must be smaller than the divisor.","Seven leftovers form another complete group."],"solutionSteps":[{"title":"Apply the bound","body":"For divisor 7, the standard remainder must be one of 0 through 6. Therefore 7 is impossible."}],"tags":["remainder bound","division"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["division-algorithm bound zero through six","independent regrouping of seven leftovers into one full group","answer-choice audit"],"notes":["Only choice D violates the strict upper bound."]}},
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"practice","transferLevel":"mixed","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-same-class","title":"Same Position Modulo Nine","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Congruence","difficulty":2,"statement":"Which statement is true?","choices":[{"label":"A","text":"58 ≡ 4 (mod 9)"},{"label":"B","text":"58 ≡ 5 (mod 9)"},{"label":"C","text":"58 ≡ 8 (mod 9)"},{"label":"D","text":"58 ≡ 9 (mod 9)"}],"answer":"A","shortAnswer":"58 ≡ 4 (mod 9)","hints":["Subtract each proposed representative from 58.","Look for a multiple of 9."],"solutionSteps":[{"title":"Use the difference","body":"58−4=54=9×6, so 58 and 4 share a remainder modulo 9."}],"tags":["congruence","divisible difference"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["difference divisibility check","independent quotient-remainder equation 58 equals 9 times 6 plus 4","answer-choice audit"],"notes":["Four is the unique standard residue among the choices."]}},
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"practice","transferLevel":"mixed","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-product-residues","title":"Reduce Before Multiplying","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Modular arithmetic","difficulty":2,"statement":"What is the remainder when 37×48 is divided by 5?","choices":[{"label":"A","text":"0"},{"label":"B","text":"1"},{"label":"C","text":"2"},{"label":"D","text":"4"}],"answer":"B","shortAnswer":"1","hints":["Replace each factor by its remainder modulo 5.","Reduce 2×3 to a standard remainder."],"solutionSteps":[{"title":"Use small representatives","body":"37≡2 and 48≡3 modulo 5, so 37×48≡6≡1 modulo 5."}],"tags":["modular multiplication","remainders"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["modular factor reduction","independent full product 1776 divided by 5 leaves 1","answer-choice audit"],"notes":["Both methods give standard remainder one."]}},
  {"schemaVersion":"1.0.0","lessonId":"N5","purpose":"practice","transferLevel":"challenge","targetConcepts":["N5"],"inspirationProblemIds":[],"problem":{"id":"original-n5-two-conditions","title":"Two Remainder Conditions","sourceType":"Original","contest":"Original","category":"Number Theory","subcategory":"Simultaneous congruences","difficulty":3,"statement":"What is the least integer greater than 30 that leaves remainder 2 when divided by 4 and remainder 5 when divided by 7?","choices":[{"label":"A","text":"33"},{"label":"B","text":"40"},{"label":"C","text":"47"},{"label":"D","text":"54"},{"label":"E","text":"61"}],"answer":"D","shortAnswer":"54","hints":["List the remainder-5 class modulo 7 above 30.","Test those candidates modulo 4 in order."],"solutionSteps":[{"title":"Generate one class","body":"The candidates are 33,40,47,54,…"},{"title":"Apply the second condition","body":"Their remainders modulo 4 are 1,0,3,2, so 54 is first."}],"tags":["simultaneous remainders","least solution"],"sourceName":"Mathinking","license":"Original"},"validation":{"status":"validated","answerVerified":true,"solutionVerified":true,"uniquenessVerified":true,"prerequisiteAuditPassed":true,"wordingReviewed":true,"notParaphraseOfBank":true,"validationMethods":["ordered sieve of one congruence class","independent direct equations 54 equals 4 times 13 plus 2 and 7 times 7 plus 5","period check modulo lcm 28","answer-choice audit"],"notes":["Fifty-four is the least solution above the stated bound."]}}
